# Modelo de credenciais — copie para secrets.toml e preencha com os dados reais.
# O arquivo secrets.toml NUNCA deve ir para o GitHub.
# Supabase: use a conexão "Session pooler" (compatível com IPv4), disponível em Connect > Direct.
[connections.postgresql]
dialect = "postgresql"
driver = "psycopg2"
host = "aws-X-REGIAO.pooler.supabase.com"
port = "5432"
database = "postgres"
username = "postgres.SEU_PROJECT_REF"
password = "SUA_SENHA"
query = { sslmode = "require" }
